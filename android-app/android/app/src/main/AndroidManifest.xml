<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      allowBackup=false: WebView localStorage 에 로그인 세션 토큰이 있다 - adb/클라우드 백업으로 빠져나가지 않게 막는다.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 공유 받기: 갤러리/THETA 앱 "공유 -> SEASTAR 360" (SeastarNativePlugin 이 처리) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Android 11+ 패키지 가시성: THETA 앱 열기(SeastarNativePlugin.shouldOverrideLoad).
         웹 SoT = public/js/modules/33_ThetaIntake.js THETA_APP.PACKAGE 와 같은 값이어야 한다. -->
    <queries>
        <package android:name="com.theta360" />
    </queries>

    <!-- Permissions: 필요한 것만.
         INTERNET  - 원격 URL 앱(scan.seastar.work).
         LOCATION  - 48_GPS 의 navigator.geolocation (WebView 위치 요청 시 Capacitor 가 런타임 권한을 묻는다).
         CAMERA 는 선언하지 않는다 - <input capture> 는 시스템 카메라 앱(ACTION_IMAGE_CAPTURE)으로 찍어
         권한이 필요 없다. 선언하면 오히려 권한 미승인 시 촬영이 막힌다(Capacitor BridgeWebChromeClient.isMediaCaptureSupported).
         사진 선택은 시스템 파일 선택기(SAF)라 저장소 권한이 필요 없다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
